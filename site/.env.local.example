# Maczkó Fotó — környezeti változók
# Másold ezt a fájlt .env.local-ra.

# Az Űrlapkezelő (MM Digital) beküldési címe ehhez az oldalhoz.
# Az engedélyezett domaineket az Űrlapkezelőben kell felvenni, nem itt.
NEXT_PUBLIC_FORM_ENDPOINT=https://form.mmdigital.hu/api/form/cK9vQbOuK-GH

# Az oldal éles URL-je — ezt használja a sitemap.xml és a robots.txt.
# Alapért. https://maczkofoto.hu. Ha más domain alá deployolod, itt írd át.
NEXT_PUBLIC_SITE_URL=https://maczkofoto.hu
